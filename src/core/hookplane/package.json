{
    "name": "hookplane",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "bin": {
        "hp": "dist/cli/cli.js"
    },
    "scripts": {
        "dev": "tsc --project tsconfig.build.json --watch",
        "build": "tsc --project tsconfig.build.json",
        "test": "vitest",
        "test:run": "vitest run",
        "test:watch": "vitest --watch",
        "check-types": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0"
    },
    "exports": {
        ".": {
            "default": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "dependencies": {
        "@hookplane/backend": "workspace:*",
        "@hookplane/core": "workspace:*",
        "citty": "^0.2.2",
        "dotenv": "^17.4.2",
        "jiti": "^2.6.1",
        "neverthrow": "^8.2.0",
        "ora": "^9.3.0",
        "ts-morph": "^27.0.2",
        "voici.js": "^3.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@hookplane/stripe": "workspace:*",
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^22.15.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.2"
    }
}
