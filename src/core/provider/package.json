{
    "name": "@hookplane/provider",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev": "tsc --project tsconfig.build.json --watch",
        "build": "tsc --project tsconfig.build.json",
        "test": "doppler run -- vitest",
        "test:run": "doppler run -- vitest run",
        "test:watch": "doppler run -- vitest --watch",
        "check-types": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0"
    },
    "exports": {
        ".": {
            "default": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./harness": {
            "default": "./dist/harness/index.js",
            "types": "./dist/harness/index.d.ts"
        }
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^22.15.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.2"
    },
    "peerDependencies": {
        "@hookplane/core": "workspace:*"
    },
    "dependencies": {
        "neverthrow": "^8.2.0",
        "zocker": "^3.0.0",
        "zod": "^4.3.6"
    }
}
